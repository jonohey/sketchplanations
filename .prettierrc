{
	"useTabs": true,
	"importOrder": [
		"<THIRD_PARTY_MODULES>",
		"vanilla-cookieconsent/dist/cookieconsent.css",
		"(.*).css",
		"^(components|helpers|services|hooks|images)(/(.*))?$",
		"^[./]"
	],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"plugins": ["@trivago/prettier-plugin-sort-imports"]
}
